</button>

<a href="tel:+491627167185" class="sticky-call" id="stickyCall">
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 5c0 8 7 15 15 15l3-4-6-3-2 2c-2-1-4-3-5-5l2-2-3-6-4 3z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
  Jetzt anrufen
</a>

<div id="toast" role="status" aria-live="polite"></div>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  const menuToggle = document.getElementById('menuToggle');
  const navLinks = document.getElementById('navLinks');
  menuToggle.addEventListener('click', () => {
    const isOpen = navLinks.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    menuToggle.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
  });
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navLinks.classList.remove('open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Menü öffnen');
  }));

  document.querySelectorAll('.menu-chips a').forEach(chip => {
    chip.addEventListener('click', (e) => {
      const id = chip.getAttribute('href').slice(1);
      const target = document.getElementById(id);
      if (target && target.tagName === 'DETAILS') {
        e.preventDefault();
        target.open = true;
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  let toastTimer;
  function showToast(msg){
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
  }

  function loadMap(){
    const frame = document.getElementById('mapFrame');
    frame.innerHTML = '<iframe src="https://www.google.com/maps?q=Maria-Probst-Stra%C3%9Fe+18,+80939+M%C3%BCnchen&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Moe\'s Kebap Standort"></iframe>';
  }

  const backToTop = document.getElementById('backToTop');
  const stickyCall = document.getElementById('stickyCall');
  const heroEl = document.querySelector('.hero');
  window.addEventListener('scroll', () => {
    const nearBottom = (window.innerHeight + window.scrollY) > document.documentElement.scrollHeight - 250;
    backToTop.classList.toggle('show', window.scrollY > 600 && !nearBottom);
    const pastHero = window.scrollY > heroEl.offsetHeight - 80;
    stickyCall.classList.toggle('show', pastHero && !nearBottom);
  }, { passive: true });
  backToTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
