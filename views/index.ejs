<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --forest:#0f2e21;
    --moss:#1c4a34;
    --sage:#8a9b5e;
    --sage-light:#c9d3a8;
    --leaf:#9ec25c;
    --leaf-light:#d3e3a6;
    --cream:#faf6ec;
    --cream-2:#eef1e2;
    --ink:#1a1a16;
    --paper-line:rgba(20,19,16,0.14);
    --radius:3px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;color-scheme:light only;background-color:var(--cream);}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important;animation-iteration-count:1 !important;transition-duration:0.001ms !important;}
  }
  a:focus-visible, button:focus-visible, .order-card:focus-visible{
    outline:2px solid var(--forest);outline-offset:2px;
  }
  .skip-link{
    position:absolute;left:1rem;top:-60px;background:var(--forest);color:var(--cream);
    padding:0.7rem 1.2rem;z-index:999;border-radius:var(--radius);transition:top .2s;
  }
  .skip-link:focus{top:1rem;}
  body{
    font-family:'Instrument Sans',sans-serif;
    background-color:var(--cream);
    color:var(--ink);
    line-height:1.6;
    overflow-x:hidden;
    min-height:100vh;
  }
  h1,h2,h3,.display{
    font-family:'Instrument Serif', serif;
    font-weight:400;
    color:var(--forest);
    line-height:1.08;
    letter-spacing:0;
  }
  h2{font-size:clamp(1.9rem,4vw,2.6rem);}
  h3{font-size:1.3rem;}
  p{max-width:62ch;}
  img{display:block;max-width:100%;}
  .wrap{max-width:1120px;margin:0 auto;padding:0 1.5rem;}
  .sr-only{
    position:absolute;width:1px;height:1px;padding:0;margin:-1px;
    overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
  }

  /* ---------- buttons ---------- */
  .btn{
    display:inline-flex;align-items:center;gap:.5rem;
    padding:0.9rem 1.7rem;border-radius:var(--radius);
    font-family:'Instrument Sans',sans-serif;font-weight:600;font-size:0.92rem;
    text-decoration:none;border:1.5px solid transparent;cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-cream{background:var(--cream);color:var(--forest);}
  .btn-cream:hover{box-shadow:0 10px 22px rgba(0,0,0,0.25);}
  .btn-outline{background:transparent;color:var(--cream);border-color:rgba(250,246,236,0.55);}
  .btn-outline:hover{border-color:var(--cream);}
  .btn-forest{background:var(--forest);color:var(--cream);}
  .btn-forest:hover{box-shadow:0 10px 22px rgba(15,46,33,0.25);}

  /* ---------- nav ---------- */
  header{
    position:sticky;top:0;z-index:100;
    background:rgba(250,246,236,0.94);backdrop-filter:blur(6px);
    border-bottom:2px solid var(--moss);
  }
  .nav-wrap{max-width:1120px;margin:0 auto;padding:0.7rem 1.5rem;display:flex;align-items:center;justify-content:space-between;}
  .brand{display:flex;align-items:center;gap:0.6rem;text-decoration:none;}
  .brand img{height:38px;width:auto;}
  .brand span{font-family:'Instrument Serif',serif;font-style:italic;font-size:1.3rem;color:var(--forest);}
  .nav-links{display:flex;gap:2rem;list-style:none;}
  .nav-links a{color:var(--forest);text-decoration:none;font-weight:500;font-size:0.92rem;}
  .nav-links a:hover{color:var(--moss);}
  #menuToggle{
    display:none;background:none;border:none;cursor:pointer;padding:0.4rem;
    width:44px;height:44px;align-items:center;justify-content:center;
  }
  #menuToggle svg{width:24px;height:24px;color:var(--forest);}
  @media (max-width:800px){
    .nav-wrap{display:grid;grid-template-columns:44px 1fr 44px;grid-template-rows:44px;align-items:center;padding:0.6rem 1rem;}
    .brand{grid-column:2;grid-row:1;justify-self:center;}
    .nav-wrap > nav{grid-column:1;grid-row:1;}
    #menuToggle{grid-column:3;grid-row:1;justify-self:end;display:inline-flex;}
    .nav-links{
      display:none;position:fixed;top:64px;left:0;right:0;background:var(--cream);
      flex-direction:column;gap:0;padding:0.5rem 1.5rem 1.5rem;border-bottom:1px solid var(--paper-line);
    }
    .nav-links.open{display:flex;}
    .nav-links li{border-bottom:1px solid var(--paper-line);}
    .nav-links a{display:block;padding:0.9rem 0;}
  }

  /* ---------- hero ---------- */
  .hero{position:relative;min-height:80vh;max-height:900px;display:flex;align-items:flex-end;overflow:hidden;color:var(--cream);}
  .hero-bg{position:absolute;inset:0;z-index:0;overflow:hidden;}
  .hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 42%;
    animation:heroZoom 28s ease-out forwards;transform-origin:center 42%;}
  @keyframes heroZoom{from{transform:scale(1);}to{transform:scale(1.09);}}
  .hero-scrim{
    position:absolute;inset:0;z-index:1;
    background:linear-gradient(180deg, rgba(10,14,10,0.25) 0%, rgba(10,14,10,0.55) 45%, rgba(9,13,9,0.92) 100%);
  }
  .hero-content{position:relative;z-index:2;padding:3.5rem 0 3rem;width:100%;}
  .hero-content .wrap{max-width:760px;margin:0;padding-left:clamp(1.5rem,6vw,5rem);padding-right:1.5rem;}
  .hero h1{font-style:normal;font-size:clamp(2.5rem,6.5vw,3.8rem);color:var(--cream);margin-bottom:1.1rem;max-width:16ch;}
  .hero .lead{font-size:1.05rem;color:rgba(250,246,236,0.88);max-width:44ch;margin-bottom:1.8rem;}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:0.9rem;margin-bottom:1.4rem;}
  .hero-menu-link{color:var(--cream);font-weight:600;font-size:0.9rem;text-decoration:underline;text-underline-offset:3px;}
  .hero-badges{display:flex;flex-wrap:wrap;gap:1.4rem;margin-top:1.8rem;}
  .hero-badges span{display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;color:rgba(250,246,236,0.82);}
  .hero-badges svg{width:16px;height:16px;color:var(--leaf-light);}

  /* ---------- story ---------- */
  #geschichte{padding:5rem 0;}
  .story-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:3.5rem;align-items:center;}
  .story-text p{color:#3d3d36;margin-bottom:1rem;}
  .story-stat{margin-top:1.6rem;padding-top:1.2rem;border-top:1px solid var(--paper-line);font-size:0.92rem;color:var(--moss);font-weight:600;}
  .story-photo{max-width:300px;margin-left:auto;}
  .story-photo img{border-radius:var(--radius);width:100%;height:100%;object-fit:cover;aspect-ratio:4/5;box-shadow:0 20px 40px rgba(20,19,16,0.15);}
  @media (max-width:880px){
    .story-grid{grid-template-columns:1fr;}
    .story-photo{order:-1;max-width:260px;margin:0 auto;}
  }

  /* ---------- divider ---------- */
  .divider{display:flex;align-items:center;gap:1rem;padding:0 0;max-width:280px;margin:0 auto;}
  .divider hr{flex:1;border:none;border-top:1px solid var(--paper-line);}
  .divider svg{width:18px;height:18px;color:var(--leaf);flex-shrink:0;}
  .divider-wrap{padding:2.5rem 0;background:var(--cream);}

  /* ---------- speisekarte ---------- */
  #speisekarte{background:var(--cream-2);padding:5rem 0;}
  .section-head{max-width:640px;margin:0 auto 2rem;text-align:center;}
  .section-head p{margin:0.6rem auto 0;color:#4a4a42;}
  .menu-chips{
    display:flex;gap:0.6rem;overflow-x:auto;
    padding:0.3rem 0.2rem 2rem;
    -webkit-overflow-scrolling:touch;scrollbar-width:none;
  }
  .menu-chips::-webkit-scrollbar{display:none;}
  .menu-chips a{
    flex-shrink:0;white-space:nowrap;
    font-size:0.82rem;font-weight:600;color:var(--moss);
    border:1px solid var(--paper-line);border-radius:20px;
    padding:0.45rem 1rem;background:var(--cream);
  }
  .menu-chips a:hover{background:var(--forest);color:var(--cream);border-color:var(--forest);}
  .menu-columns{columns:2;column-gap:3.5rem;}
  .menu-category{break-inside:avoid;margin-bottom:1.4rem;scroll-margin-top:90px;border-bottom:1px solid var(--paper-line);}
  .menu-category-head{
    display:flex;align-items:center;gap:0.9rem;padding:1rem 0;
    cursor:pointer;list-style:none;-webkit-tap-highlight-color:transparent;
  }
  .menu-category-head::-webkit-details-marker{display:none;}
  .menu-category-head::after{
    content:"";width:9px;height:9px;margin-left:auto;flex-shrink:0;
    border-right:2px solid var(--moss);border-bottom:2px solid var(--moss);
    transform:rotate(45deg);transition:transform .2s;
  }
  details[open] > .menu-category-head::after{transform:rotate(-135deg);}
  .menu-category-head img{width:52px;height:52px;border-radius:50%;object-fit:cover;flex-shrink:0;}
  .menu-category-head h3{font-style:italic;color:var(--forest);}
  .menu-category > .menu-row:first-of-type{margin-top:0.2rem;}
  .menu-category > .menu-row:last-of-type{border-bottom:none;}
  .menu-row{padding:0.55rem 0;border-bottom:1px solid var(--paper-line);}
  .menu-row-top{display:flex;align-items:baseline;gap:0.5rem;}
  .menu-row .name{font-weight:600;font-size:0.98rem;}
  .menu-row .leader{flex:1;border-bottom:2px dotted rgba(20,19,16,0.28);margin-bottom:5px;min-width:16px;}
  .menu-row .price{font-family:'Instrument Serif',serif;font-style:italic;font-size:1.05rem;white-space:nowrap;color:var(--moss);}
  .menu-row .desc{display:block;font-size:0.82rem;color:#6a6a60;margin-top:3px;max-width:56ch;}
  .menu-note{max-width:640px;margin:2.5rem auto 0;text-align:center;font-size:0.85rem;color:#5c5c52;}
  .menu-note strong{color:var(--forest);}
  @media (max-width:800px){
    .menu-columns{columns:1;}
  }

  /* ---------- reviews ---------- */
  .reviews{background:var(--ink);color:var(--cream);padding:5.5rem 0;}
  .reviews .section-head h2{color:var(--cream);}
  .reviews .section-head p{color:rgba(250,246,236,0.7);}
  .review-featured{max-width:620px;margin:0 auto 3rem;text-align:center;}
  .review-featured .stars{justify-content:center;color:var(--leaf-light);display:flex;gap:2px;margin-bottom:1rem;}
  .review-featured blockquote{
    font-family:'Instrument Serif', serif;font-style:normal;
    font-size:clamp(1.2rem,2.8vw,1.6rem);line-height:1.5;color:var(--cream);
  }
  .review-featured cite{display:block;margin-top:1.1rem;font-size:0.85rem;color:var(--leaf-light);font-style:normal;font-weight:600;}
  .review-minor-grid{display:flex;gap:3rem;max-width:820px;margin:0 auto;flex-wrap:wrap;justify-content:center;padding-top:2.5rem;border-top:1px solid rgba(250,246,236,0.14);}
  .review-minor{flex:1 1 280px;font-size:0.9rem;color:rgba(250,246,236,0.78);}
  .review-minor .stars{color:var(--leaf-light);display:flex;gap:2px;margin-bottom:0.5rem;}
  .review-minor cite{display:block;margin-top:0.6rem;font-size:0.8rem;color:var(--leaf-light);font-style:normal;font-weight:600;}

  /* ---------- bestellen ---------- */
  #bestellen{background:var(--cream);padding:5.5rem 0;}
  .order-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-bottom:2rem;}
  .order-card{
    border-radius:var(--radius);padding:2.1rem 1.6rem;text-align:center;
    display:flex;flex-direction:column;align-items:center;gap:0.8rem;min-width:0;
    text-decoration:none;font-family:inherit;cursor:pointer;border:none;
    transition:transform .15s, box-shadow .15s;
  }
  .order-card:hover{transform:translateY(-3px);}
  .order-card svg{width:28px;height:28px;}
  .order-card h4{font-family:'Instrument Serif',serif;font-style:italic;font-size:1.15rem;}
  .order-card p.tag{font-size:0.8rem;}
  .order-card .pill{font-size:0.72rem;font-weight:700;letter-spacing:0.3px;padding:0.3rem 0.8rem;border-radius:20px;text-transform:uppercase;}
  .order-card.is-live{background:var(--forest);color:var(--cream);}
  .order-card.is-live svg{color:var(--leaf-light);}
  .order-card.is-live p.tag{color:rgba(250,246,236,0.7);}
  .order-card.is-live .pill{background:var(--leaf);color:var(--forest);}
  .order-card-embed{justify-content:flex-start;}
  .embed-box{
    background:var(--cream);border-radius:var(--radius);padding:0.3rem;
    max-width:100%;overflow-x:auto;
  }
  .embed-box iframe{display:block;}
  @media (max-width:400px){
    .embed-box{width:224px;height:120px;overflow:hidden;margin:0 auto;padding:0;}
    .embed-box iframe{transform:scale(0.8);transform-origin:top left;}
  }
  .order-follow-btn{display:flex;margin:0 auto;width:fit-content;}
  .order-follow-btn svg{width:20px;height:20px;flex-shrink:0;}
  @media (max-width:700px){
    .order-grid{grid-template-columns:1fr;}
  }

  /* ---------- standort ---------- */
  #standort{background:var(--forest);color:var(--cream);padding:5.5rem 0;}
  .standort-grid{display:grid;grid-template-columns:1fr 1fr;gap:3.5rem;align-items:center;}
  .standort-info h2{color:var(--cream);}
  .standort-info p{color:rgba(250,246,236,0.8);}
  .info-row{display:flex;gap:0.8rem;margin-top:1.4rem;}
  .info-row svg{width:19px;height:19px;color:var(--leaf-light);flex-shrink:0;margin-top:2px;}
  .info-row h4{font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--leaf-light);margin-bottom:0.2rem;font-family:'Instrument Sans',sans-serif;font-weight:700;}
  .info-row p, .info-row a{color:rgba(250,246,236,0.9);font-size:0.92rem;text-decoration:none;}
  .info-row a:hover{text-decoration:underline;}
  table.hours{width:100%;border-collapse:collapse;font-size:0.92rem;}
  table.hours td{padding:0.25rem 0;color:rgba(250,246,236,0.85);}
  table.hours td:last-child{text-align:right;font-weight:600;color:var(--cream);}
  .standort-info .btn{margin-top:1.6rem;}
  .map-postcard{
    position:relative;transform:rotate(-1.6deg);background:var(--cream);
    padding:0.6rem 0.6rem 2.4rem;box-shadow:0 24px 50px rgba(0,0,0,0.35);
    max-width:420px;margin:0 auto;
  }
  .map-postcard .map-frame{overflow:hidden;min-height:300px;background:var(--cream-2);}
  .map-postcard .map-frame iframe{width:100%;height:100%;border:0;min-height:300px;}
  .map-caption{position:absolute;left:0;right:0;bottom:0.65rem;text-align:center;font-family:'Instrument Serif',serif;font-style:italic;color:var(--ink);font-size:0.95rem;}
  .map-placeholder{
    min-height:300px;display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;gap:0.7rem;padding:1.6rem;
  }
  .map-placeholder svg{width:28px;height:28px;color:var(--moss);}
  .map-placeholder p{font-size:0.82rem;color:#4a4a42;max-width:260px;}
  .map-directions-link{font-size:0.8rem;font-weight:600;color:var(--moss);text-decoration:underline;}
  @media (max-width:880px){
    .standort-grid{grid-template-columns:1fr;}
    .map-postcard{margin-top:1rem;}
  }

  /* ---------- footer ---------- */
  footer{background:var(--ink);color:var(--cream);padding:3rem 0 2rem;}
  .footer-grid{display:flex;justify-content:space-between;flex-wrap:wrap;gap:2rem;margin-bottom:2rem;}
  footer .brand-word img{height:52px;width:auto;}
  footer .foot-links{display:flex;gap:2rem;font-size:0.85rem;flex-wrap:wrap;list-style:none;}
  footer .foot-links a{color:rgba(250,246,236,0.75);text-decoration:none;}
  footer .foot-links a:hover{color:var(--leaf-light);}
  footer .foot-bottom{border-top:1px solid rgba(250,246,236,0.14);padding-top:1.4rem;font-size:0.78rem;color:rgba(250,246,236,0.55);display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.6rem;}

  /* ---------- toast ---------- */
  #toast{
    position:fixed;left:50%;bottom:1.6rem;transform:translate(-50%,20px);
    background:var(--forest);color:var(--cream);padding:0.9rem 1.4rem;border-radius:var(--radius);
    font-size:0.88rem;opacity:0;pointer-events:none;transition:opacity .25s, transform .25s;z-index:200;
    box-shadow:0 10px 24px rgba(0,0,0,0.25);max-width:90vw;text-align:center;
  }
  #toast.show{opacity:1;transform:translate(-50%,0);}

  /* ---------- back to top ---------- */
  .back-to-top{
    position:fixed;bottom:1.6rem;right:1.6rem;width:44px;height:44px;border-radius:50%;
    background:var(--forest);color:var(--cream);display:flex;align-items:center;justify-content:center;
    border:none;cursor:pointer;opacity:0;pointer-events:none;transform:translateY(10px);
    transition:opacity .25s, transform .25s;z-index:150;box-shadow:0 8px 20px rgba(0,0,0,0.25);
  }
  .back-to-top.show{opacity:1;pointer-events:auto;transform:translateY(0);}
  .back-to-top svg{width:20px;height:20px;}

  /* ---------- sticky mobile call bar ---------- */
  .sticky-call{
    display:none;position:fixed;left:1rem;right:1rem;bottom:1.4rem;z-index:140;
    background:var(--forest);color:var(--cream);padding:1rem;border-radius:var(--radius);
    text-align:center;font-weight:600;font-size:0.95rem;text-decoration:none;
    align-items:center;justify-content:center;gap:0.6rem;
    box-shadow:0 10px 24px rgba(0,0,0,0.3);
    opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .25s, transform .25s;
  }
  .sticky-call svg{width:18px;height:18px;color:var(--leaf-light);}
  @media (max-width:800px){
    .sticky-call.show{display:flex;opacity:1;pointer-events:auto;transform:translateY(0);}
    .back-to-top{bottom:5.6rem;}
  }
</style>
</head>
<body>
<a href="#top" class="skip-link">Zum Inhalt springen</a>
<div id="top"></div>

<header>
  <div class="nav-wrap">
    <a class="brand" href="#top" aria-label="Moe's Kebap – Startseite">
      <img src="nav-icon.png" alt="" width="140" height="140" style="height:38px;width:auto;">
      <span>Moe's Kebap</span>
    </a>
    <nav aria-label="Hauptnavigation">
      <ul class="nav-links" id="navLinks">
