<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<title>Öffnungszeiten – Moe's Kebap Admin</title>
<style>
  body{font-family:sans-serif;background:#faf6ec;color:#1a1a16;margin:0;padding:2rem;display:flex;justify-content:center;}
  form{background:#fff;padding:2rem;border-radius:6px;width:420px;}
  h1{font-size:1.2rem;margin-bottom:1.4rem;}
  .day-row{display:flex;align-items:center;gap:0.7rem;padding:0.6rem 0;border-bottom:1px solid #eee;}
  .day-row label.day{width:90px;font-weight:600;font-size:0.88rem;}
  .day-row input[type="time"]{padding:0.4rem;border:1px solid #ccc;border-radius:4px;width:90px;}
  .day-row .closed-toggle{display:flex;align-items:center;gap:0.4rem;font-size:0.82rem;margin-left:auto;white-space:nowrap;}
  button{width:100%;padding:0.7rem;background:#0f2e21;color:#fff;border:none;border-radius:4px;cursor:pointer;margin-top:1.4rem;}
</style>
</head>
<body>
  <form method="POST" action="/admin/hours/edit">
    <h1>Öffnungszeiten bearbeiten</h1>

    <% hours.forEach(function(h, i) { %>
      <div class="day-row">
        <label class="day"><%= h.day_name %></label>
        <input type="time" name="opens_<%= i %>" value="<%= h.opens || '' %>" <%= h.closed ? 'disabled' : '' %>>
        <span>–</span>
        <input type="time" name="closes_<%= i %>" value="<%= h.closes || '' %>" <%= h.closed ? 'disabled' : '' %>>
        <label class="closed-toggle">
          <input type="checkbox" name="closed_<%= i %>" onchange="this.closest('.day-row').querySelectorAll('input[type=time]').forEach(el => el.disabled = this.checked)" <%= h.closed ? 'checked' : '' %>>
          geschlossen
        </label>
      </div>
    <% }) %>

    <button type="submit">Speichern</button>
  </form>
</body>
</html>
