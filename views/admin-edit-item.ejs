<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<title>Bearbeiten – Moe's Kebap Admin</title>
<style>
  body{font-family:sans-serif;background:#faf6ec;color:#1a1a16;margin:0;padding:2rem;display:flex;justify-content:center;}
  form{background:#fff;padding:2rem;border-radius:6px;width:360px;}
  h1{font-size:1.2rem;margin-bottom:1.4rem;}
  label{display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.3rem;margin-top:1rem;}
  input,textarea,select{width:100%;padding:0.6rem;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;font-family:inherit;}
  button{width:100%;padding:0.7rem;background:#0f2e21;color:#fff;border:none;border-radius:4px;cursor:pointer;margin-top:1.4rem;}
  a.back{display:inline-block;margin-top:1rem;font-size:0.85rem;color:#666;}
</style>
</head>
<body>
  <form method="POST" action="<%= item.id ? '/admin/items/' + item.id + '/edit' : '/admin/items/new' %>">
    <h1><%= item.id ? 'Gericht bearbeiten' : 'Neues Gericht anlegen' %></h1>

    <label for="category_id">Kategorie</label>
    <select id="category_id" name="category_id" required>
      <% categories.forEach(function(cat) { %>
        <option value="<%= cat.id %>" <%= cat.id === item.category_id ? 'selected' : '' %>><%= cat.name %></option>
      <% }) %>
    </select>

    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="<%= item.name %>" required>

    <label for="price">Preis in Euro (z.B. 7,50)</label>
    <input type="text" id="price" name="price" value="<%= item.price_cents ? (item.price_cents / 100).toFixed(2).replace('.', ',') : '' %>" required>

    <label for="description">Beschreibung (optional)</label>
    <textarea id="description" name="description" rows="3"><%= item.description || '' %></textarea>

    <button type="submit">Speichern</button>
  </form>
</body>
</html>
