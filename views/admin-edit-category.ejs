<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<title>Kategorie bearbeiten – Moe's Kebap Admin</title>
<style>
  body{font-family:sans-serif;background:#faf6ec;color:#1a1a16;margin:0;padding:2rem;display:flex;justify-content:center;}
  form{background:#fff;padding:2rem;border-radius:6px;width:360px;}
  h1{font-size:1.2rem;margin-bottom:1.4rem;}
  label{display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.3rem;margin-top:1rem;}
  input{width:100%;padding:0.6rem;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;}
  button{width:100%;padding:0.7rem;background:#0f2e21;color:#fff;border:none;border-radius:4px;cursor:pointer;margin-top:1.4rem;}
  img.preview{width:80px;height:80px;border-radius:50%;object-fit:cover;display:block;margin-top:0.6rem;}
  .none{font-size:0.8rem;color:#999;margin-top:0.6rem;}
</style>
</head>
<body>
  <form method="POST" action="/admin/categories/<%= category.id %>/edit" enctype="multipart/form-data">
    <h1>Kategorie: <%= category.name %></h1>

    <label>Aktuelles Bild</label>
    <% if (category.image) { %>
      <img class="preview" src="/img/<%= category.image %>">
    <% } else { %>
      <p class="none">Kein Bild hinterlegt.</p>
    <% } %>

    <label for="image">Neues Bild hochladen (ersetzt das aktuelle)</label>
    <input type="file" id="image" name="image" accept="image/*">

    <button type="submit">Speichern</button>
  </form>
</body>
</html>
